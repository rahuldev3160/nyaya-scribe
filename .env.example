# Copy this file to .env for local development (never commit .env)
# On Hetzner/Railway, set these as environment variables on the server.

# Required: Anthropic API key for AI quiz grading
ANTHROPIC_API_KEY=sk-ant-api03-...

# Required: Google OAuth credentials (get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
OAUTH_REDIRECT_URI=https://your-domain.com/0_Login

# Static service credential Nyaya Arena presents to call /internal/v1/* on THIS app
# (web/blueprints/internal_api_bp.py). Was already required by that blueprint but
# missing from this file — added retroactively.
ARENA_SERVICE_API_KEY=replace-with-shared-secret-from-arena

# --- Nyaya Arena RBI redesign (PLAN-007/008/009, 2026-08-29) ---
# MUST stay 'local' in production until Rahul explicitly approves flipping it, per
# PLAN-008 §3's staged rollout. 'local' = today's unchanged behavior (rbi_prep_bp.py
# and internal_api_bp.py read rbi_questions directly). 'recall' = fetch/score go
# through Nyaya Recall's internal API instead.
RBI_CONTENT_SOURCE=local
RECALL_API_URL=http://localhost:8000
# The value must match Recall's own INTERNAL_API_KEY_SCRIBE_RBI (Devthorium/.env) --
# generate once (e.g. `openssl rand -hex 32`), Rahul shares it into both repos'
# .env files. No value has been generated/shared yet as of this commit.
INTERNAL_API_KEY_SCRIBE_RBI=replace-with-shared-secret-from-devthorium
